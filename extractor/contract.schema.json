{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EBB2675/schema-studio/extractor/contract/1.0",
  "$comment": "Adapted from schematerial src/schematerial/extraction/contract.schema.json (contract 1.2) at commit df3839b. Field names and meanings are unchanged; the requirements of contract 1.2 apply unconditionally. Added, all optional: source.commit, class methods, top-level modules and usage.",
  "title": "Schema Studio extraction document",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$comment": "Commit of the installed source package, when it was installed from git.",
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "version",
        "module",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "modules": {
      "$comment": "The modules that were read, each with the classes it exposes at module level.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/enum_value"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "$comment": "Code that acts on a class (normalizers and the helpers they call), keyed by class id. Describes code, not schema.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/usage_entry"
        }
      }
    },
    "report": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "skipped",
              "warning",
              "partial"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "source",
    "classes",
    "enums",
    "report"
  ],
  "additionalProperties": false,
  "$defs": {
    "attribute": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "quantity",
            "subsection",
            "property"
          ]
        },
        "description": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "repeats": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/$defs/annotations"
        }
      },
      "required": [
        "name",
        "kind",
        "range"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "enum_value": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "annotations": {
              "$ref": "#/$defs/annotations"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "class": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "bases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          }
        },
        "annotations": {
          "$ref": "#/$defs/annotations"
        },
        "effective_attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effective_attribute"
          }
        },
        "methods": {
          "$comment": "Public functions reachable on the class, with the module that defines each.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        }
      },
      "required": [
        "id",
        "name",
        "bases",
        "attributes",
        "effective_attributes"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "datatype",
            "class",
            "enum"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "effective_attribute": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "quantity",
            "subsection",
            "property"
          ]
        },
        "declaring_class_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "kind",
        "declaring_class_id"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "module"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "classes"
      ],
      "additionalProperties": false
    },
    "usage_entry": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "normalize_method",
            "normalize_function",
            "utility_function"
          ]
        },
        "qualname": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": "string",
          "minLength": 1
        },
        "doc": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "qualname",
        "module",
        "short_name"
      ],
      "additionalProperties": false
    }
  }
}
